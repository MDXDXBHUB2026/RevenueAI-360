# ====================================================
# RevenueAI 360 Environment Configuration
# ====================================================

# Environment Mode
ENVIRONMENT=development
LOG_LEVEL=INFO

# Backend API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Database Configuration
# Default PostgreSQL with pgvector (Port 5434 to avoid port collision with other local instances)
DATABASE_URL=postgresql://postgres:postgres@localhost:5434/revenueai
DATABASE_URL_TEST=sqlite:///./test_revenueai.db

# LLM Provider Configuration
# Supported options: mock, openai, anthropic, gemini, ollama
LLM_PROVIDER=openai
DEFAULT_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# API Keys (Provide when using corresponding commercial providers)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Ollama Configuration (Local fallback)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# RAG & Vector Index Configuration
VECTOR_DIMENSION=1536
CHUNK_SIZE=500
CHUNK_OVERLAP=50
SIMILARITY_THRESHOLD=0.65

# Automation Tier & Guardrails
AUTOMATION_MODE=strict_hitl  # strict_hitl or full_auto_demo
GUARDRAIL_STRICTNESS=high    # low, medium, high
